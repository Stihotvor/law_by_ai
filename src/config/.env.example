# PostgreSQL
POSTGRES_USER=lawbyai
POSTGRES_PASSWORD=lawbyai
POSTGRES_DB=lawbyai
# Optional — used to assemble POSTGRES_URL when it is not set directly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Services
APP_PORT=8501
APP_NAME=law-by-ai

# Redis
REDIS_USER=
REDIS_PASSWORD=
# Optional — used to assemble REDIS_URL when it is not set directly
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Connection strings (compose provides these in-container; uncomment locally)
POSTGRES_URL=postgresql://lawbyai:lawbyai@postgres:5432/lawbyai
REDIS_URL=redis://redis:6379/0

# Optional — Celery overrides; default to REDIS_URL when unset
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND_URL=

# S3 object store (SeaweedFS). The names keep the MINIO_ prefix.
MINIO_ENDPOINT=localhost:8333
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=legal-documents
MINIO_SECURE=false

# OCR (off by default). When true, document content leaves this host.
OCR_ENABLED=false
MISTRAL_API_KEY=

# Tavily source
TAVILY_API_KEY=

# Init program (python -m bootstrap): first tenant and admin
INIT_TENANT_ID=platform
INIT_TENANT_NAME=Platform
INIT_ADMIN_EMAIL=
INIT_ADMIN_NAME=Admin
INIT_ADMIN_PASSWORD=
