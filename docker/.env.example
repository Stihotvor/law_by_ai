# Docker Compose environment — copy to `.env` for local overrides.
# The stack uses an env file so database host/port/credentials are configured
# in one place; the app/celery/test containers receive these values and build
# their URLs in src/config/settings.py.
#
# In-container service names: the PostgreSQL host is ``postgres`` and Redis is
# ``redis`` (the docker-compose service names), not ``localhost``.

# Application
APP_NAME=law-by-ai
APP_PORT=8501

# PostgreSQL
POSTGRES_USER=lawbyai
POSTGRES_PASSWORD=lawbyai
POSTGRES_DB=lawbyai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Per-agent models as comma-separated agent=model pairs, e.g.:
# LLM_MODELS=research=gpt-4o-mini,fetcher=qwen2.5:7b
LLM_MODELS=

EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text

RERANK_BASE_URL=https://api.cohere.com/v1
RERANK_API_KEY=
RERANK_MODEL=rerank-v3.5
