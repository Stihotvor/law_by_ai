# Docker Compose environment — copy to `.env` for local overrides.
# The stack uses an env file so database host/port/credentials are configured
# in one place; the app/celery/test containers receive these values and build
# their URLs in src/config/settings.py.
#
# In-container service names: the PostgreSQL host is ``postgres`` and Redis is
# ``redis`` (the docker-compose service names), not ``localhost``.

# Application
APP_NAME=law-by-ai
APP_PORT=8501

# PostgreSQL
POSTGRES_USER=lawbyai
POSTGRES_PASSWORD=lawbyai
POSTGRES_DB=lawbyai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# LLM / embeddings / reranking (ADR-0014)
# OpenAI-compatible endpoints; each agent can use its own model.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Default model for all agents (individual agents override via LLM_MODEL_<AGENT>).
LLM_MODEL=
# Per-agent model overrides, e.g.:
# LLM_MODEL_DOCUMENT_FETCHER=qwen2.5:7b
# LLM_MODEL_DOCUMENT_PROCESSOR=gpt-4o-mini
# LLM_MODEL_LEGAL_RESEARCH=gpt-4o-mini
# LLM_MODEL_CHANGE_TRACKER=
# LLM_MODEL_KNOWLEDGE_GRAPH=
# LLM_MODEL_ANALYSIS=
# LLM_MODEL_BUREAUCRACY_ASSISTANT=

EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text

RERANK_BASE_URL=https://api.cohere.com/v1
RERANK_API_KEY=
RERANK_MODEL=rerank-v3.5
