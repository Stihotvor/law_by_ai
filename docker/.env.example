# Docker Compose environment. Copy it to `docker/.env` and run `chmod 600 docker/.env`.
# Compose reads this file to fill `${...}` in docker-compose.yml. Each service
# gets only the variables listed in its `environment:` block.
# Replace every value that starts with `change-me` before the first start.
# The init program refuses to run while a secret still starts with `change-me`.
#
# Hosts are fixed in docker-compose.yml (`postgres`, `redis`, `s3`).
# POSTGRES_HOST and REDIS_HOST below are read only by the `test` service.

# Application
APP_NAME=law-by-ai
APP_PORT=8501

# PostgreSQL
POSTGRES_USER=lawbyai
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=lawbyai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (the server requires the password)
REDIS_USER=
REDIS_PASSWORD=change-me-redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# S3 object store (SeaweedFS). The names keep the MINIO_ prefix.
# The S3 service accepts this key pair. Use letters and digits only.
MINIO_ACCESS_KEY=lawbyai-s3
MINIO_SECRET_KEY=change-me-s3-secret
MINIO_ENDPOINT=s3:8333
MINIO_BUCKET=legal-documents
# No TLS inside the private backend network. The settings default is true.
MINIO_SECURE=false

# LLM / embeddings / reranking
# OpenAI-compatible endpoints; each agent can use its own model.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Default model for all agents (individual agents override via LLM_MODEL_<AGENT>).
LLM_MODEL=
# Per-agent model overrides, e.g.:
# LLM_MODEL_DOCUMENT_FETCHER=qwen2.5:7b
# LLM_MODEL_DOCUMENT_PROCESSOR=gpt-4o-mini
# LLM_MODEL_LEGAL_RESEARCH=gpt-4o-mini
# LLM_MODEL_CHANGE_TRACKER=
# LLM_MODEL_KNOWLEDGE_GRAPH=
# LLM_MODEL_ANALYSIS=
# LLM_MODEL_BUREAUCRACY_ASSISTANT=

EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text

RERANK_BASE_URL=https://api.cohere.com/v1
RERANK_API_KEY=
RERANK_MODEL=rerank-v3.5

# OCR (off by default). When true, document content leaves this host.
OCR_ENABLED=false
MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# OCR_TIMEOUT=120.0
# OCR_MAX_BYTES=20971520

# Fetch
# FETCH_HTTP_TIMEOUT=10.0
# FETCH_TOTAL_TIMEOUT=60.0
# FETCH_MAX_BYTES=52428800

# Tavily source
TAVILY_API_KEY=
# TAVILY_TIMEOUT=60.0
# TAVILY_MAX_PAGES=20
# SEJM_MIN_INTERVAL=0.5

# First start only: init creates this tenant and admin if they are missing.
INIT_TENANT_ID=platform
INIT_TENANT_NAME=Platform
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_NAME=Admin
INIT_ADMIN_PASSWORD=change-me-admin-password
